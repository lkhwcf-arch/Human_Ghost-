{
  "name": "human-ghost-telemetry-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-config": "node scripts/sync.mjs",
    "dev": "npm run prepare-config && vite --host 127.0.0.1",
    "build": "npm run prepare-config && vite build",
    "test": "node --test tests/*.test.mjs",
    "firebase": "npx firebase-tools@14.27.0",
    "deploy": "npm run build && npx firebase-tools@14.27.0 deploy --only hosting --project humanghost-f85de"
  },
  "dependencies": { "firebase": "^12.0.0", "exceljs": "4.4.0" },
  "overrides": { "@grpc/grpc-js": "^1.13.6", "uuid": "^11.1.1" },
  "devDependencies": { "vite": "^7.0.0", "@firebase/rules-unit-testing": "^5.0.0" }
}
